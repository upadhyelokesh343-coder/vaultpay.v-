    {
      "name": "4. Webhooks (Callbacks Reference)",
      "description": "Examples of incoming asynchronous HTTP POST callbacks sent by our gateway to your configured `notifyUrl`.",
      "item": [
        {
          "name": "Payin Webhook Callback Example",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"merchantOrderNo\": \"ORD-177000123\",\n  \"gatewayOrderNo\": \"MPAYIN-20260804112000-A1B2\",\n  \"amount\": \"500.00\",\n  \"actualAmount\": \"500.00\",\n  \"feeCharged\": \"30.00\",\n  \"settleAmount\": \"470.00\",\n  \"payinState\": 2,\n  \"utr\": \"421509123456\",\n  \"sign\": \"9f8a7b6c5d4e3f2a1b0c9d8e7f6a5b4c\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/webhook/sample-payin-receiver",
              "host": ["{{baseUrl}}"],
              "path": ["api", "webhook", "sample-payin-receiver"]
            },
            "description": "Reference representation of the incoming signed JSON payload sent to your `notifyUrl` upon payment completion. Your server must respond with `SUCCESS` (HTTP 200)."
          },
          "response": []
        },
        {
          "name": "Payout Webhook Callback Example",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
